# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# On the server: NODE_ENV=production. The app then refuses to start until APP_ORIGIN is https://, GOOGLE_CLIENT_ID is set,
# ALLOW_DEV_LOGIN=0, PGPASSWORD is not the sample one and READ_SALT is set (server/security.mjs productionProblems).
NODE_ENV=development
PORT=3000
# Production listens on 127.0.0.1 only (behind the reverse proxy); the Docker image sets 0.0.0.0 inside the container
HOST=
# Address of the reverse proxy that adds X-Forwarded-Proto (loopback = on this machine)
TRUST_PROXY=loopback

# PostgreSQL (docker-compose.yml uses the same values)
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=prsru
PGUSER=prsru
# Sample for development; a long random password on the server
PGPASSWORD=prsru-dev

# Google Sign-In: OAuth client ID (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=

# Public address of the site: links in emails, sitemap.xml, Open Graph, the HTTPS redirect and the CSRF check
APP_ORIGIN=http://localhost:3000

# Development only: lets /api/auth/dev sign in without Google. Must be 0 on the server.
ALLOW_DEV_LOGIN=1

# Where uploaded files are stored
UPLOAD_DIR=uploads
# Salt for counting reads once per reader per day (any long random text)
READ_SALT=

# Email notifications (SMTP of the university / Google Workspace). Empty SMTP_HOST = emails are kept
# in the outbox (admin.html → อีเมลแจ้งเตือน) but not sent. SMTP_SECURE=1 for port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ข่าว มรส. <no-reply@sru.ac.th>
