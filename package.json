{
  "name": "pr-sru-newsroom",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:migrate": "node --env-file=.env server/migrate.mjs",
    "dev": "node --watch-path=server server/dev.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --env-file=.env --test --test-concurrency=1 \"server/test/*.test.mjs\"",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json",
    "check": "npm run lint && npm run typecheck",
    "db:seed": "node --env-file=.env server/seed.mjs",
    "build:css": "node server/build-css.mjs",
    "build:images": "node server/build-images.mjs",
    "build:fonts": "node server/build-fonts.mjs",
    "build:pdf": "node server/build-pdf.mjs",
    "backup": "node --env-file-if-exists=.env server/backup.mjs",
    "backup:restore-test": "node --env-file-if-exists=.env server/restore-test.mjs",
    "a11y": "node server/a11y.mjs"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "compression": "^1.8.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "google-auth-library": "^11.3.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.13.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^17.13.0",
    "pdfjs-dist": "^6.4.299",
    "subset-font": "^2.9.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  }
}
