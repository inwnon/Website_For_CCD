{
  // Browser scripts shared by the pages (npm run typecheck); the server has its own: server/tsconfig.json
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["*.js", "globals.d.ts"]
}
